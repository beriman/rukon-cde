# ===========================
# Database Configuration
# ===========================
DATABASE_URL=postgresql://user:password@host:port/database?schema=public

# For Supabase (recommended for production):
# DATABASE_URL=postgresql://postgres.PROJECT_ID:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# For local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rukon_dev

# ===========================
# JWT Configuration
# ===========================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# ===========================
# AWS S3 Configuration (Optional)
# ===========================
# Leave empty to use local file storage fallback
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ===========================
# Email Configuration (Optional)
# ===========================
# Leave empty to use console logging fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@rukon-cde.com

# ===========================
# Application Configuration
# ===========================
PORT=3001
NODE_ENV=development

# ===========================
# Frontend Configuration
# ===========================
NEXT_PUBLIC_API_URL=http://localhost:3001
