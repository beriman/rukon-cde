# ===========================
# VERCEL ENVIRONMENT VARIABLES
# ===========================
# Copy these variables to Vercel Dashboard → Settings → Environment Variables

# ===========================
# Database Configuration (REQUIRED)
# ===========================
# Untuk Supabase (contoh format):
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ===========================
# JWT Configuration (REQUIRED)
# ===========================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-random-string
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# ===========================
# AWS S3 Configuration (Optional - for file storage)
# ===========================
# Leave empty to use local file storage fallback
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# ===========================
# Email Configuration (Optional - using Resend)
# ===========================
# Leave empty to use console logging fallback
RESEND_API_KEY=
EMAIL_FROM=noreply@rukon-cde.com

# ===========================
# AI Configuration (Optional - for AI Chat)
# ===========================
GEMINI_API_KEY=

# ===========================
# Application Configuration
# ===========================
PORT=3001
NODE_ENV=production

# ===========================
# Frontend Configuration
# ===========================
NEXT_PUBLIC_API_URL=https://rukon-cde-api.vercel.app

# ===========================
# Supabase Authentication (REQUIRED for Frontend)
# ===========================
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
