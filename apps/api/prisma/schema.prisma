generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  signatureUrl  String?   // Digital Signature Image URL
  role          GlobalRole @default(USER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  
  organizations OrganizationUser[]
  refreshTokens RefreshToken[]
  passwordResets PasswordReset[]
  auditLogs     AuditLog[]
  reportedIncidents Incident[]
  dailyReports  HseDailyReport[]
  submittedProgress ProgressUpdate[]
  assignedActions IncidentAction[]
  submittals    Submittal[]
  approvedCorrespondences Correspondence[] @relation("CorrespondenceApprover")
  inspections   InspectionForm[]
  
  // Transmittals
  sentTransmittals      Transmittal[] @relation("TransmittalSender")
  receivedTransmittals  TransmittalRecipient[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
  @@map("users")
}

model Organization {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  
  users       OrganizationUser[]
  projects    Project[]
  invitations Invitation[]
  planningDocuments PlanningDocument[]
  
  // Official Letterhead Configuration
  letterheadHeader String?
  letterheadFooter String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("organizations")
}

model OrganizationUser {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           OrgRole      @default(MEMBER)
  
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@map("organization_users")
}

model Project {
  id             String       @id @default(uuid())
  name           String
  code           String
  organizationId String
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  folders        Folder[]
  planningDocuments PlanningDocument[]
  taskDeliveryPlans TaskDeliveryPlan[]
  approvalWorkflows ApprovalWorkflow[]
  
  // Epic 5: HSE
  incidents            Incident[]
  permits              PermitToWork[]
  hseReports           HseDailyReport[]
  inspectionForms      InspectionForm[]
  safetyMeetings       SafetyMeeting[]
  hsePersonnel         HsePersonnel[]
  emergencyContacts    HseEmergencyContact[]
  hseAudits            HseAudit[]
  hseTargets           HseTarget[]
  inspectionTemplates  InspectionTemplate[]
  emergencyDrills      EmergencyDrill[]
  
  // Epic 4: Construction Monitoring
  workPackages   WorkPackage[]
  submittals     Submittal[]
  procurementItems ProcurementItem[]
  billOfQuantities BillOfQuantities[]
  progressClaims ProgressClaim[]
  variationOrders VariationOrder[]
  cobieValidations CobieValidation[]
  correspondences Correspondence[]
  
  // Epic 6: BCF & Smart Review
  bcfTopics      BcfTopic[]
  validationReports ValidationReport[]
  simulationLinks SimulationLink[]
  schedules      Schedule[]
  classifications ClassificationAssignment[]
  idsSpecifications IdsSpecification[]
  
  // Epic 7: Mobile Field App
  siteCaptures   SiteCapture[]
  tasks          ProjectTask[] 
  
  // Epic 8: Transmittals
  transmittals   Transmittal[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  status         ProjectStatus @default(ACTIVE)

  @@index([status])
  @@map("projects")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])

  parentId  String?
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderHierarchy")
  files     File[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Epic 3: Design Collaboration
  discipline String? // e.g. "ARCH", "STRUCT", "MEP"
  isSystem   Boolean @default(false)
  
  permissions Json? // e.g. { "read": ["*"], "write": ["ADMIN"] }

  @@map("folders")
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

model Invitation {
  id             String       @id @default(uuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token          String       @unique
  role           OrgRole      @default(MEMBER)
  expiresAt      DateTime
  used           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  invitedBy      String?
  
  @@index([organizationId])
  @@index([token])
  @@map("invitations")
}

model InspectionTemplate {
    id          String          @id @default(cuid())
    name        String
    type        InspectionType
    items       Json // Template questions
    projectId   String?
    isDefault   Boolean         @default(false)
    createdAt   DateTime        @default(now())

    project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model EmergencyDrill {
    id            String   @id @default(cuid())
    projectId     String
    type          String // FIRE, EARTHQUAKE, EVACUATION, CHEMICAL_SPILL
    date          DateTime
    duration      Int // minutes
    participants  String[] // Array of participant names
    findings      String?
    photos        String[]
    conductedBy   String
    createdAt     DateTime @default(now())

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
model File {
  id           String        @id @default(uuid())
  name         String
  originalName String
  uniqueId     String
  s3Key        String
  size         Int
  mimeType     String
  folderId     String
  folder       Folder        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploadedBy   String
  version      Int           @default(1)
  currentVersion Int         @default(1)
  cdeState     String        @default("WIP")
  versions     FileVersion[]
  
  // Epic 3: References
  linkSourceId String?
  linkSource   File?   @relation("FileLinks", fields: [linkSourceId], references: [id])
  linkedFiles  File[]  @relation("FileLinks")
  markups      DrawingMarkup[]
  submittals   Submittal[]
  validationReports ValidationReport[]
  simulationLinks SimulationLink[]
  transmittalItems TransmittalItem[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  @@unique([folderId, uniqueId])
  @@index([folderId])
  @@index([s3Key])
  @@index([uniqueId])
  @@map("files")
}

model FileVersion {
  id           String   @id @default(uuid())
  fileId       String
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version      Int

  // [NEW] Kolom Revisi ISO 19650 (e.g., "P01.01", "C01")
  revisionCode String?  @map("revision_code")

  s3Key        String
  size         Int
  uploadedBy   String
  cdeState     String   @default("WIP")
  createdAt    DateTime @default(now())
  
  @@unique([fileId, version])
  @@index([fileId])
  @@index([s3Key])
  @@map("file_versions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  channel   String   @default("IN_APP")
  createdAt DateTime @default(now())
  
  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  
  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum AuditAction {
  LOGIN
  LOGOUT
  PASSWORD_RESET
  FILE_UPLOAD
  FILE_DOWNLOAD
  FILE_MOVE
  FILE_PROMOTE
  FILE_PUBLISH
  FILE_ARCHIVE
  FILE_DELETE
  PROJECT_CREATE
  PROJECT_UPDATE
  PROJECT_ARCHIVE
  FOLDER_CREATE
  FOLDER_DELETE
  INVITATION_SEND
  INVITATION_ACCEPT
}


model AuditLog {
  id          String      @id @default(uuid())
  userId      String
  action      AuditAction
  resourceId  String?
  resourceType String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([action])
  @@index([resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// --- EPIC 2: Strategic Planning & Delivery Tools ---

enum TemplateType {
  OIR
  PIR
  AIR
  EIR
  BEP
  TIDP
  MIDP
}

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model DocumentTemplate {
  id          String       @id @default(uuid())
  type        TemplateType
  language    String       @default("id")
  name        String
  content     Json
  description String?
  isSystem    Boolean      @default(false)
  
  organizationId String? // If null, system-wide template
  // organization Organization? @relation(fields: [organizationId], references: [id]) // Optional relation
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("document_templates")
}

model PlanningDocument {
  id             String         @id @default(uuid())
  title          String
  type           TemplateType
  content        Json           // The document data
  status         DocumentStatus @default(DRAFT)
  version        String         @default("1.0")
  
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id])
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  createdBy      String
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  @@index([projectId])
  @@index([organizationId])
  @@map("planning_documents")
}

model TaskDeliveryPlan {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  teamId         String?
  name           String
  
  deliverables   TaskDeliverable[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@map("task_delivery_plans")
}

model TaskDeliverable {
  id             String   @id @default(uuid())
  planId         String
  taskDeliveryPlan TaskDeliveryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  // ISO 19650 ID Parts
  originator     String
  volume         String
  level          String
  type           String
  role           String
  number         String
  
  title          String
  description    String?
  
  // Dates for Gantt
  startDate      DateTime?
  endDate        DateTime? // Delivery Date
  durationDays   Int?
  
  assignedTo     String? // User ID
  status         String  // PLANNED, IN_PROGRESS, DELIVERED
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("task_deliverables")
}

model ApprovalWorkflow {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  name           String
  stages         Json     // Array of stage definitions
  isActive       Boolean  @default(true)
  submittals     Submittal[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("approval_workflows")
}

model ProjectTask {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  checklist   Json?    // Array of { id: string, text: string, completed: boolean }
  status      String   @default("OPEN")
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@map("project_tasks")
}

model DrawingMarkup {
  id        String   @id @default(uuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  authorId  String
  layerData Json
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("drawing_markups")
}

// --- EPIC 5: HSE Management ---

model Incident {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  type        IncidentType
  severity    Severity
  date        DateTime
  location    String
  description String
  reportedBy  String
  reporter    User?    @relation(fields: [reportedBy], references: [id]) 
  
  witnesses   String[]
  photos      String[]  // S3 keys
  rootCause   String?
  correctiveActions Json?
  status      IncidentStatus
  actions     IncidentAction[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([projectId])
  @@index([date])
  @@map("incidents")
}

model IncidentAction {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  description String
  assigneeId  String?
  assignee    User?    @relation(fields: [assigneeId], references: [id])
  
  dueDate     DateTime?
  completedAt DateTime?
  status      ActionStatus @default(OPEN)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([incidentId])
  @@map("incident_actions")
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum IncidentType {
  FIRST_AID
  MTI
  RWI
  LTI
  FATALITY
  ILLNESS
  VEHICLE_INCIDENT
  SPILL
  NEAR_MISS
  UNSAFE_ACT
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CLOSED
}

model PermitToWork {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id])
  type            PTWType
  workDescription String
  location        String
  startDate       DateTime
  endDate         DateTime
  approvals       Json     // Array of approvers objects
  status          PTWStatus
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@map("permit_to_works")
}

enum PTWType {
  HOT_WORK
  CONFINED_SPACE
  WORK_AT_HEIGHT
  EXCAVATION
  ELECTRICAL
}

enum PTWStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  COMPLETED
  EXPIRED
  REJECTED
}

model HseDailyReport {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])

  date         DateTime
  manhours     Int      @default(0) // Total manhours for the day
  workersCount Int      @default(0)
  
  weather      String?
  notes        String?
  
  recordedBy   String
  recorder     User     @relation(fields: [recordedBy], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([projectId, date])
  @@map("hse_daily_reports")
}

model HseTarget {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  
  periodStart DateTime // Start of week/month
  periodEnd   DateTime
  type        String   // WEEKLY, MONTHLY
  
  // Targets
  manhours       Int?
  ltiFreeManhours Int?
  safeManhours   Int?
  
  inspections    Int?
  meetings       Int?
  observations   Int? // Safety Cards
  
  // Specific targets can be JSON or cols
  details        Json? // { "TBM": 5, "HEAVY_EQUIPMENT": 10 }
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([projectId])
  @@map("hse_targets")
}

model InspectionForm {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  
  type        InspectionType
  date        DateTime
  inspectorId String
  inspector   User     @relation(fields: [inspectorId], references: [id])
  
  items       InspectionItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([projectId])
  @@map("inspection_forms")
}

model InspectionItem {
  id       String   @id @default(uuid())
  formId   String
  form     InspectionForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  
  question String
  result   InspectionResult
  photo    String?  // S3 key
  comment  String?
  
  createdAt DateTime @default(now())
  
  @@index([formId])
  @@map("inspection_items")
}

enum InspectionType {
  EXCAVATOR
  CRANE
  SCAFFOLDING
  FIRE_EXTINGUISHER
  ELECTRICAL_TOOLS
  GENERAL_SITE
  HEAVY_EQUIPMENT
  LIFTING_GEAR
  VEHICLE
  TOOLS
  PRE_MOBILIZATION
}

enum InspectionResult {
  PASS
  FAIL
  NA
}

model SafetyMeeting {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  
  type       MeetingType
  topic      String
  date       DateTime
  attendees  Json     // Array of names or user IDs
  photo      String?  // S3 key for attendance sheet
  notes      String?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([projectId])
  @@index([date])
  @@map("safety_meetings")
}

enum MeetingType {
  TBM
  INDUCTION
  EMERGENCY_DRILL
  GENERAL_SAFETY_TALK
  WEEKLY_SAFETY_MEETING
  COMMITTEE_MEETING
  TRAINING
}

model HsePersonnel {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  
  name        String
  company     String
  role        String?
  
  documents   Json     // { type: 'SIO', number: 'xxx', expiry: '2025-01-01' }
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([projectId])
  @@map("hse_personnel")
}

model HseEmergencyContact {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  
  name      String
  role      String   // 'Project Manager', 'Safety Manager', 'Ambulance', 'Fire', 'Police'
  phone     String
  isPrimary Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([projectId])
  @@map("hse_emergency_contacts")
}

model HseAudit {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  
  auditDate   DateTime
  auditor     String
  scope       String
  findings    HseAuditFinding[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([projectId])
  @@map("hse_audits")
}

model HseAuditFinding {
  id            String   @id @default(uuid())
  auditId       String
  audit         HseAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  
  clause        String   // ISO clause reference
  severity      AuditSeverity
  description   String
  evidence      String?
  
  status        AuditStatus @default(OPEN)
  responseDate  DateTime?
  closureEvidence String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([auditId])
  @@map("hse_audit_findings")
}

enum AuditSeverity {
  MAJOR
  MINOR
  OBSERVATION
}

enum AuditStatus {
  OPEN
  RESPONDED
  VERIFIED
  CLOSED
}




// --- EPIC 4: Construction Monitoring ---


enum Discipline {
  STRUCT
  ARCH
  MEP
}

model WorkPackage {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  
  name           String   // e.g., "Level 1 - Zone A"
  discipline     Discipline
  weight         Float    @default(1.0) // Relative weight for aggregation
  
  // Placeholder for future Schedule/Cost linking
  scheduleTaskId String?
  bqItemId       String?
  
  progressUpdates ProgressUpdate[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([projectId])
  @@index([discipline])
  @@map("work_packages")
}

model ProgressUpdate {
  id            String      @id @default(uuid())
  workPackageId String
  workPackage   WorkPackage @relation(fields: [workPackageId], references: [id])
  
  date          DateTime
  percentage    Float       // 0-100
  
  notes         String?
  photos        String[]    // S3 keys
  
  submittedBy   String
  submitter     User        @relation(fields: [submittedBy], references: [id])
  
  createdAt     DateTime    @default(now())
  
  @@index([workPackageId])
  @@index([date])
  @@map("progress_updates")
}

enum SubmittalType {
  SHOP_DRAWING
  METHOD_STATEMENT
  MATERIAL_APPROVAL
  RFI
  WORK_REQUEST
  MODEL_LOD400
  MODEL_LOD500
  AS_BUILT_DRAWING
}

enum SubmittalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  APPROVED_WITH_NOTES
  REJECTED
  RESUBMITTED
}

model Submittal {
  id              String          @id @default(uuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id])
  
  type            SubmittalType
  referenceNumber String          @unique // SD-STR-001
  title           String
  description     String?
  
  fileId          String
  file            File            @relation(fields: [fileId], references: [id])
  
  workflowId      String?
  workflow        ApprovalWorkflow? @relation(fields: [workflowId], references: [id])
  
  status          SubmittalStatus @default(DRAFT)
  
  // Workflow Tracking
  currentStageIndex Int           @default(0)
  activeApprovers   String[]      // Array of User IDs who need to approve now
  reviews           Json?         // History: [{ stage: 0, approver: "id", status: "APPROVED", date: "..." }]
  
  submittedBy     String
  submitter       User            @relation(fields: [submittedBy], references: [id])
  
  reviewComments  String?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([projectId])
  @@index([status])
  @@map("submittals")
}

// Story 4.4: Procurement & BQ
enum ProcurementStatus {
  ORDERED
  MANUFACTURED
  SHIPPING
  ON_SITE
  INSTALLED
}

model ProcurementItem {
  id          String            @id @default(uuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id])
  
  name        String
  category    String            // Long Lead Item, Regular, etc
  quantity    Float
  unit        String
  
  status      ProcurementStatus @default(ORDERED)
  supplier    String?
  orderDate   DateTime?
  deliveryDate DateTime?
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  @@index([projectId])
  @@map("procurement_items")
}

model BillOfQuantities {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  description String?
  currency    String   @default("IDR")
  
  items       BoQItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([projectId])
  @@map("bill_of_quantities")
}

model BoQItem {
  id            String   @id @default(uuid())
  boqId         String
  boq           BillOfQuantities @relation(fields: [boqId], references: [id], onDelete: Cascade)
  
  itemCode      String?
  description   String
  unit          String
  quantity      Float
  unitRate      Float
  amount        Float
  actualQty     Float    @default(0)
  
  workPackageId String?
  
  mappings      CostMapping[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([boqId])
  @@map("boq_items")
}

model CostMapping {
  id          String   @id @default(uuid())
  boqItemId   String
  boqItem     BoQItem  @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  
  elementGuid String   // IFC GlobalId
  modelId     String   // File ID
  
  createdAt   DateTime @default(now())
  
  @@index([boqItemId])
  @@index([elementGuid])
  @@map("cost_mappings")
}

// Story 4.5: Payment & Billing
enum ClaimStatus {
  DRAFT
  SUBMITTED
  CERTIFIED
  INVOICED
  PAID
}

model ProgressClaim {
  id              String      @id @default(uuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id])
  
  claimNumber     Int
  period          String      // e.g., "Month 3"
  
  baseAmount      Float       // Contract amount * %
  voAmount        Float       @default(0) // Variation Orders
  totalAmount     Float
  
  status          ClaimStatus @default(DRAFT)
  submittedBy     String
  
  certifiedAmount Float?
  certifiedDate   DateTime?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([projectId])
  @@map("progress_claims")
}

model VariationOrder {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  
  voNumber    String
  title       String
  description String
  
  costImpact  Float
  timeImpact  Int?     // days
  
  status      String   // PROPOSED, APPROVED, REJECTED
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([projectId])
  @@map("variation_orders")
}

// Story 4.7: COBie Compliance
model CobieValidation {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  
  fileId      String
  fileName    String
  
  totalElements    Int
  compliantElements Int
  complianceScore   Float
  
  missingFields    Json // Array of missing field reports
  
  createdAt   DateTime @default(now())
  
  @@index([projectId])
  @@map("cobie_validations")
}

// Story 4.8: Correspondence
enum CorrespondenceCategory {
  GENERAL
  OFFICIAL_LETTER
}

model Correspondence {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  
  type        String   // SITE_MEMO, SITE_INSTRUCTION
  referenceNumber String @unique
  
  from        String
  to          String[]
  subject     String
  message     String
  
  attachments String[] // File IDs
  
  // Official Letter Support
  category    CorrespondenceCategory @default(GENERAL)
  pdfUrl      String?  // Storage URL for the generated immutable PDF
  
  status      String   // SENT, READ, REPLIED, PENDING_APPROVAL
  
  // Approval Workflow
  approvedById String?
  approvedBy   User?   @relation("CorrespondenceApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([projectId])
  @@map("correspondences")
}
// --- EPIC 6: BCF Issue Tracking ---

enum BcfTopicStatus {
  OPEN
  IN_PROGRESS
  SOLVED
  CLOSED
}

enum BcfTopicPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum BcfTopicType {
  ERROR
  WARNING
  INFO
  REQUEST
}

model BcfTopic {
  id             String           @id @default(uuid())
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  guid           String           @unique @default(uuid()) // BCF GUID standard
  title          String
  description    String?
  priority       BcfTopicPriority @default(NORMAL)
  status         BcfTopicStatus   @default(OPEN)
  type           BcfTopicType     @default(WARNING)
  
  assignedTo     String?
  creationAuthor String
  
  comments       BcfComment[]
  viewpoints     BcfViewpoint[]
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  
  @@index([projectId])
  @@index([guid])
  @@map("bcf_topics")
}

model BcfComment {
  id             String   @id @default(uuid())
  topicId        String
  topic          BcfTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  guid           String   @unique @default(uuid())
  comment        String
  author         String
  date           DateTime @default(now())
  
  viewpointId    String?  // Optional link to a specific viewpoint
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([topicId])
  @@map("bcf_comments")
}

model BcfViewpoint {
  id             String   @id @default(uuid())
  topicId        String
  topic          BcfTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  guid           String   @unique @default(uuid())
  index          Int      @default(0) // Order of viewpoints
  
  // Camera Data (JSON for flexibility: perspective or orthogonal)
  eyePosition    Json     // {x, y, z}
  direction      Json     // {x, y, z}
  upVector       Json     // {x, y, z}
  
  // Selection & Visibility
  selection      Json?    // Array of IfcGuids
  visibility     Json?    // Array of hidden IfcGuids (or exceptions)
  
  snapshot       String?  // S3 key or Base64 (prefer S3 for size)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([topicId])
  @@map("bcf_viewpoints")
}

// --- EPIC 6.3: Smart Review ---

model ValidationRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   // e.g., "Naming", "Property"
  ruleType    String   // "REGEX", "EXISTS", "VALUE"
  config      Json     // { property: "FireRating", regex: "^FR-\d+" }
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("validation_rules")
}

model ValidationReport {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelId     String   // File ID
  file        File     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  result      Json     // Summary of failures
  score       Float    // e.g. 85.5% pass
  
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([modelId])
  @@map("validation_reports")
}

// --- EPIC 6.4: 4D Simulation ---

model Schedule {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  name          String
  type          String   // "CSV", "MS_PROJECT", "P6"
  
  tasks         ScheduleTask[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([projectId])
  @@map("schedules")
}

model ScheduleTask {
  id            String   @id @default(uuid())
  scheduleId    String
  schedule      Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  taskId        String   // The external ID (e.g. "1.1", "A100")
  name          String
  startDate     DateTime
  endDate       DateTime
  parentId      String? 
  
  simulationLinks SimulationLink[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([scheduleId, taskId])
  @@map("schedule_tasks")
}

model SimulationLink {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Link to internal ScheduleTask
  scheduleTaskId String
  scheduleTask   ScheduleTask @relation(fields: [scheduleTaskId], references: [id], onDelete: Cascade)

  elementId   String   // IFC GUID 
  modelId     String   // File ID
  file        File     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  config      Json?    // { color, animation }

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([scheduleTaskId])
  @@map("simulation_links")
}

model ClassificationAssignment {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  elementGuid String
  system      String   // "Uniclass 2015", "OmniClass"
  code        String
  description String

  assignedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, elementGuid, system])
  @@index([projectId])
  @@index([code])
  @@map("classification_assignments")
}

model IdsSpecification {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  name        String
  description String?
  
  rules       IdsRule[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ids_specifications")
}

model IdsRule {
  id          String           @id @default(uuid())
  specId      String
  spec        IdsSpecification @relation(fields: [specId], references: [id], onDelete: Cascade)
  
  ifcEntity   String           // e.g., "IfcWall"
  propertySet String           // e.g., "Pset_WallCommon"
  property    String           // e.g., "FireRating"
  requirement String           // e.g., "PRESENT", "MATCHES"
  value       String?          // e.g., "120" if MATCHES

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("ids_rules")
}

// --- EPIC 7: Mobile Field App ---

enum CaptureType {
  PHOTO
  VIDEO
  VOICE_NOTE
}

model SiteCapture {
  id            String      @id @default(uuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id])
  
  drawingId     String?     // Reference to floor plan for pin
  capturedBy    String
  
  captureType   CaptureType
  fileUrl       String      // S3 key for the media file
  thumbnailUrl  String?     // S3 key for thumbnail
  
  // GPS Coordinates
  latitude      Decimal?    @db.Decimal(10, 7)
  longitude     Decimal?    @db.Decimal(10, 7)
  altitude      Decimal?    @db.Decimal(10, 2)
  gpsAccuracy   Decimal?    @db.Decimal(6, 2)
  
  // Pin on Plan coordinates
  pinX          Decimal?    @db.Decimal(5, 2)
  pinY          Decimal?    @db.Decimal(5, 2)
  
  // Commentary
  commentary    String?
  voiceNoteUrl  String?
  voiceNoteDurationSec Int?
  
  // File info
  fileSizeBytes BigInt      @default(0)
  mimeType      String?
  
  // Sync status
  synced        Boolean     @default(false)
  uploadedAt    DateTime?
  capturedAt    DateTime    @default(now())
  
  // Extra metadata (EXIF, device info, etc)
  metadata      Json?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([projectId])
  @@index([capturedBy])
  @@index([synced])
  @@map("site_captures")
}

// --- EPIC 8: Transmittals ---

model Transmittal {
  id              String   @id @default(uuid())
  transmittalNo   String   
  subject         String
  message         String?
  
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id])
  
  senderId        String
  sender          User     @relation("TransmittalSender", fields: [senderId], references: [id])
  
  recipients      TransmittalRecipient[]
  items           TransmittalItem[]
  
  status          TransmittalStatus @default(DRAFT)
  sentAt          DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([projectId, transmittalNo])
  @@index([projectId])
  @@map("transmittals")
}

enum TransmittalStatus {
  DRAFT
  SENT
  VOID
}

model TransmittalRecipient {
  id              String   @id @default(uuid())
  transmittalId   String
  transmittal     Transmittal @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  
  recipientId     String
  recipient       User     @relation(fields: [recipientId], references: [id])
  
  status          RecipientStatus @default(PENDING)
  viewedAt        DateTime?
  acknowledgedAt  DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([transmittalId, recipientId])
  @@map("transmittal_recipients")
}

enum RecipientStatus {
  PENDING
  RECEIVED
  ACKNOWLEDGED
}

model TransmittalItem {
  id              String   @id @default(uuid())
  transmittalId   String
  transmittal     Transmittal @relation(fields: [transmittalId], references: [id], onDelete: Cascade)
  
  fileId          String
  file            File     @relation(fields: [fileId], references: [id])
  
  revision        String?
  purpose         String?  // e.g. "For Approval", "For Information"
  
  createdAt       DateTime @default(now())
  
  @@unique([transmittalId, fileId])
  @@map("transmittal_items")
}

