            "automated_fix": "Add @IsUnique() validator or check existence before insert",
            "directive_update": "Always validate uniqueness before database insert operations",
            "confidence_score": 0.90,
            "success_count": 0,
            "failure_count": 0,
            "example_fix": "// Add validation\nconst existing = await this.prisma.user.findUnique({ where: { email } });\nif (existing) throw new ConflictException('Email already exists');"
        },
