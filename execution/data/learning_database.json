            "failure_count": 0,
            "example_fix": "@Roles(UserRole.ORG_ADMIN, UserRole.SYSTEM_ADMIN)\n@UseGuards(JwtAuthGuard, RolesGuard)\nasync adminOnlyEndpoint() { ... }"
        },
